{
  "scripts": {
    "test": "node -r ts-node/register --test test/**/*.ts",
    "dev": "ts-node -r tsconfig-paths/register src/app.ts",
    "build:proto": "protoc --plugin=protoc-gen-ts_proto=node_modules\\.bin\\protoc-gen-ts_proto.cmd --ts_proto_out=src\\generated --ts_proto_opt=outputServices=grpc-js,env=node,esModuleInterop=true,removeEnumPrefix=true -I=proto proto\\machugi\\chat\\*.proto",

    "build": "tsc && tsc-alias",
    "start": "node dist/src/app.js",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:test": "prettier --write \"test/**/*.{js,jsx,ts,tsx}\""
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@cosmic-unemployed-kaguya/grpc-express": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0",
    "winston": "^3.19.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "protoc": "^35.1.0",
    "ts-proto": "^2.12.0",
    "tsc-alias": "^1.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
